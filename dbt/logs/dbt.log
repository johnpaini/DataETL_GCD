  and h.data_inicio is not null
  and h.data_fim is not null
  and h.data_fim >= h.data_inicio
qualify row_number() over (
    partition by h.id_solicitacao, h.etapa, h.data_inicio, h.data_fim
    order by h.id_solicitacao
) = 1
    );
    
  
