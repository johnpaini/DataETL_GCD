    try_cast(dataCriacao as timestamp) as data_entrada,
    try_cast(dataAtualizacao as timestamp) as data_atualizacao,
    'COMPLEMENTAR_SINTETICA' as origem_fonte
from "pipeline"."main"."raw_solicitacoes_complementares"
  );

