from (
    select id_solicitacao, etapa, data_inicio, data_fim,
           count(*) over(partition by id_solicitacao, etapa, data_inicio, data_fim) as qtd
    from "pipeline"."main"."stg_historico_etapas"
) x
where qtd > 1
  );

